Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stretchedExp", "[", 
    RowBox[{"t_", ",", "G_", ",", "\[Tau]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{"G", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["t", "\[Tau]"], ")"}], "^", "\[Beta]"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"593ccd17-8e04-4c43-b169-048d5bfcc54b"],

