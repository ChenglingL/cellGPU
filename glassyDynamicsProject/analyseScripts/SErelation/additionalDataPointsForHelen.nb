Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stretchedExp", "[", 
    RowBox[{"t_", ",", "G_", ",", "\[Tau]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{"G", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["t", "\[Tau]"], ")"}], "^", "\[Beta]"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"605deec1-6afd-4927-8d67-df11f91e3c83"],

