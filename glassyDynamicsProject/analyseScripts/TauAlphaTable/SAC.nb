Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stretchedExp", "[", 
    RowBox[{"t_", ",", "G_", ",", "\[Tau]_", ",", "\[Beta]_"}], "]"}], ":=", 
   RowBox[{"G", " ", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       RowBox[{"(", 
        FractionBox["t", "\[Tau]"], ")"}], "^", "\[Beta]"}]}], "]"}]}]}], 
  ";"}]], "Input",
