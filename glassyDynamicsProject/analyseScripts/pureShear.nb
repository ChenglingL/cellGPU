               "]"}], "]"}], "]"}], "/", "4096"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"T", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"temperatures", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
